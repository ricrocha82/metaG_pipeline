// conf/base.config
// Per-process resource directives (cpus / memory / time).
// Adjust memory/time ceilings to match your actual OSC queue limits —
// values below are reasonable starting points, not measured benchmarks.

process {

    // ------ Default fallback for any process without a specific selector below ------
    cpus   = 4                 // conservative default core count
    memory = '16 GB'           // conservative default memory
    time   = '4h'              // conservative default wall time

    // ------ Virus detection (heavy: whole-genome scanning, marker search) ------
    withName: VIRSORTER {
        cpus   = params.threads   // matches -j $params.threads in the process script
        memory = '64 GB'          // VirSorter2 marker DB scan is memory-hungry on large assemblies
        time   = '12h'
    }

    withName: GENOMAD_END_TO_END {
        cpus   = params.threads   // matches --splits $params.threads in the process script
        memory = '64 GB'          // geNomad's neural network classifier + marker DB
        time   = '12h'
    }

    // ------ Lightweight Python/seqkit helper steps ------
    withName: COMBINE_VS2_GENOMAD {
        cpus   = 1                // pandas merge of two small TSVs
        memory = '4 GB'
        time   = '30m'
    }

    withName: SELECT_CONTIGS {
        cpus   = 1                // filtering a table, no heavy compute
        memory = '4 GB'
        time   = '30m'
    }

    withName: SELECT_CONTIGS_GENOMAD {
        cpus   = 1
        memory = '4 GB'
        time   = '30m'
    }

    withName: EXTRACT_CONTIGS {
        cpus   = 2                // seqkit grep, scales with contig count not CPU-bound
        memory = '8 GB'
        time   = '1h'
    }

    // withName: RENAME_ASSEMBLY {
    //     cpus   = 1                // just a symlink
    //     memory = '1 GB'
    //     time   = '10m'
    // }

    // ------ CheckV quality assessment ------
    withName: CHECKV_END_TO_END {
        cpus   = params.threads   // CheckV parallelizes gene calling/DIAMOND search
        memory = '32 GB'
        time   = '8h'
    }

    withName: FILTER_CHECKV {
        cpus   = 2                // seqkit filtering by length/completeness
        memory = '8 GB'
        time   = '1h'
    }

    // ------ Clustering ------
    withName: CLUSTERING {
        cpus   = params.threads   // ANI clustering (blastn/mmseqs-based) benefits from threads
        memory = '32 GB'
        time   = '6h'
    }

    withName: CONCAT_FASTA {
        cpus   = 1                // simple file concatenation
        memory = '4 GB'
        time   = '30m'
    }

    // ------ Read mapping ------
    withName: MAPPING_LONG_READS {
        cpus   = params.threads   // minimap2 -t threads
        memory = '32 GB'
        time   = '8h'
    }

    withName: MAPPING_SHORT_READS {
        cpus   = params.threads   // minimap2/bwa -t threads
        memory = '32 GB'
        time   = '8h'
    }

withName: SAMTOOLS {
    cpus   = params.threads
    memory = '48 GB'   // samtools sort -@ 40 without -m defaults to ~768MB/thread → ~30GB just for sorting
    time   = '4h'
    }

    // ------ Abundance ------
    withName: COVERM_ABUNDANCE {
        cpus   = params.threads   // CoverM parallelizes across BAMs
        memory = '16 GB'
        time   = '4h'
    }

    withName: CREATE_ABUND_TB {
        cpus   = 1                // small table merge/reshape
        memory = '4 GB'
        time   = '30m'
    }

    // ------ Microdiversity (heaviest step: per-position pileups across all contigs) ------
    withName: METAPOP_MICRODIVERSITY {
        cpus   = params.threads
        memory = '64 GB'
        time   = '12h'
    }
}