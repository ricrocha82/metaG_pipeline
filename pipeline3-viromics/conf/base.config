process {
    cpus   = { 1     * task.attempt }
    memory = { 4.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12    * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // iPHoP and GTDB-Tk de novo were run on whole nodes in the CoMS SOP.
    // These are starting points for a standard Pitzer node; adjust after
    // the first run (check pipeline_info/trace.txt for peak_rss).
    withName: 'IPHOP_PREDICT' {
        cpus   = 40
        memory = 170.GB
        time   = 100.h
    }
    withName: 'IPHOP_ADD_TO_DB' {
        cpus   = 40
        memory = 170.GB
        time   = 100.h
    }
    withName: 'GTDBTK_DE_NOVO' {
        cpus   = 40
        memory = 350.GB
        time   = 48.h
    }
}
