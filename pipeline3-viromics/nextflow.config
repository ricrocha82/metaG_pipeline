manifest {
    name        = 'pipeline3-viromics'
    description = 'Viral contig detection, CheckV QC, vOTU clustering, vOTU abundance, iPHoP host prediction'
    author      = 'ricrocha82'
}

params {
    input                        = null   // samplesheet.csv: sample,assembly,short_reads_1,short_reads_2 (extra columns ignored)
    outdir                       = './results'

    // ---- Virus detection ----
    detect                       = 'genomad'   // genomad | vs2 | both
    min_contig_length            = 5000        // final viral sequences shorter than this are kept out of vOTUs (saved in removed_viral_contigs.*)
    genomad_db                   = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/genomad_db'
    genomad_min_score            = 0.7         // geNomad --min-score (its own default)
    vs2_min_score                = 0.5
    vs2_groups                   = 'dsDNAphage,ssDNA'

    // ---- Filtering after CheckV (only used with --detect both) ----
    // Contigs found by only one tool must pass all three (CoMS SOP).
    exclusive_min_length         = 10000
    exclusive_min_viral_genes    = 1
    exclusive_min_genomad_score  = 0.1

    // ---- CheckV ----
    checkv_db                    = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/checkv-db-v1.0'

    // ---- vOTU clustering (MIUViG: 95% ANI, 85% AF of the shorter sequence) ----
    votu_min_ani                 = 95
    votu_min_tcov                = 85

    // ---- vOTU abundance (CoverM, minimap2-sr) ----
    coverm_min_identity          = 0.95
    coverm_min_aligned           = 0.75
    coverm_min_covered_fraction  = 0.70

    // ---- Host prediction (iPHoP) ----
    iphop_db                     = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/iphop_db_rw/Jun_2025_pub_rw'
    iphop_chunk_size             = 5000   // vOTUs per iPHoP job
    host_mags                    = null   // optional: folder of MAGs (e.g. pipeline2 dRep output) to build a custom iPHoP DB
    host_mags_ext                = 'fa'
    gtdbtk_db                    = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/GTDBTK_data/release226'

    max_memory                   = '128.GB'
    max_cpus                     = 16
    max_time                     = '240.h'
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=PAS0822'
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
