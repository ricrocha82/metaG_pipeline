// Root umbrella config: pulls in all three pipelines' own configs
// (params, profiles, process resource selectors) unchanged, then layers
// a few umbrella-only concerns on top -- a single shared output root,
// stage skip toggles, and one manifest/report/trace/timeline covering
// the whole run instead of three separate ones.
//
// Each includeConfig below resolves relative to ITS OWN file, so each
// pipeline's `includeConfig 'conf/base.config'` still finds the right
// file even though it's being pulled in from here.

params {
    outdir        = './results'   // shared output root; qc_outdir/binning_outdir/viromics_outdir nest under this
    skip_binning  = false          // set true to skip pipeline2-binning-mags
    skip_viromics = false          // set true to skip pipeline3-viromics
}

includeConfig 'pipeline1-qc-assembly/nextflow.config'
includeConfig 'pipeline2-binning-mags/nextflow.config'
includeConfig 'pipeline3-viromics/nextflow.config'

// ---- Nest each pipeline's output under the shared --outdir ----
// (overrides the standalone './results' defaults set by the includes above;
// still overridable individually, e.g. --binning_outdir /other/path).
//
// pipeline3's own config derives params.virus/vs2/genomad/checkv/cluster/...
// from params.viromics_outdir eagerly (plain string interpolation at
// config-parse time, not lazily) -- so overriding viromics_outdir alone
// would NOT cascade to those. Re-deriving the same chain here is required,
// not copy-paste cruft; keep it in sync with pipeline3-viromics/nextflow.config
// if that pipeline's own derivation chain changes.
params {
    qc_outdir       = "${params.outdir}/01_qc_assembly"
    binning_outdir  = "${params.outdir}/02_binning_mags"
    viromics_outdir = "${params.outdir}/03_viromics"

    virus          = "${params.viromics_outdir}/virus"
    vs2            = "${params.virus}/vs2"
    genomad        = "${params.virus}/genomad"
    combined       = "${params.virus}/combined"
    checkv         = "${params.virus}/checkv"
    cluster        = "${params.virus}/cluster"
    mapping        = "${params.virus}/mapping"
    abundance      = "${params.virus}/abundance"
    microdiversity = "${params.virus}/microdiversity"
}

// ---- Umbrella-level manifest / reports (override the per-pipeline ones
// set by the includes above, which would otherwise silently win since
// config blocks are evaluated top-to-bottom) ----
manifest {
    name        = 'metaG_pipeline'
    description = 'Umbrella pipeline: QC/assembly -> binning/MAGs + viromics'
    author      = 'ricrocha82'
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
