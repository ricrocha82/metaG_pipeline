process {
    cpus   = { 1     * task.attempt }
    memory = { 4.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12    * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // Kraken2 loads the whole hash.k2d into RAM (99 GB for CoMS kraken2_pluspf),
    // so the requirement is fixed by the database, not by the sample: no
    // scaling with task.attempt. Update if params.kraken2_db changes
    // (check with: ls -lh <kraken2_db>/hash.k2d).
    withName: 'KRAKEN2' {
        memory = 120.GB
    }

    // eggNOG-mapper scales with CPUs (DIAMOND); give it a full Pitzer node
    // and enough time to finish on the first attempt.
    // withName: 'EGGNOG' {
    //     cpus   = 38
    //     memory = 64.GB
    //     time   = 72.h
    // }

    // Per chunk (params.eggnog_chunk_size genes); chunks run in parallel.
    withName: 'EGGNOG' {
        cpus   = 16
        memory = 32.GB
        time   = 12.h
    }
}
