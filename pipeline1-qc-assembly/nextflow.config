manifest {
    name        = 'pipeline1-qc-assembly'
    description = 'Steps 1-9: QC, trimming, host/PhiX removal, taxonomy, assembly, annotation'
    author      = 'ricrocha82'
}

params {
    input               = null   // samplesheet.csv: sample,short_reads_1,short_reads_2
    outdir              = './results'

    // All required -- no skip toggles. Pipeline fails fast if any are
    // missing rather than silently skipping a step.
    host_fasta           = null  // host genome fasta
    phix_fasta            = null // dedicated PhiX174 reference (NOT adapters.fa)
    adapters_fasta          = null // adapter reference fasta for BBDuk trimming
    kraken2_db            = null // prebuilt Kraken2 database directory
    params.bakta_db         = null

    min_contig_size        = 1000

    max_memory               = '128.GB'
    max_cpus                  = 16
    max_time                   = '240.h'
}

profiles {
    conda {
        conda.enabled       = true
        singularity.enabled = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts   = true
        // Left enabled so GENE_ABUNDANCE (subread/featureCounts -- no local
        // .sif exists, conda-only) still resolves correctly alongside all
        // the other container-based processes.
        conda.enabled              = true
    }
    slurm {
        process.executor      = 'slurm'
        process.clusterOptions = '--account=PAS1117'
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
