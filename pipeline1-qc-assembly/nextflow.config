manifest {
    name        = 'pipeline1-qc-assembly'
    description = 'QC, trimming, host/PhiX removal, read taxonomy, assembly, annotation'
    author      = 'ricrocha82'
}

process {
    errorStrategy = 'finish'
}

params {
    input               = null   // samplesheet.csv: sample,short_reads_1,short_reads_2
    outdir              = './results'

    // References. Every default can be overridden on the command line.
    host_fasta          = null   // required: host genome fasta
    phix_fasta          = '/fs/ess/PAS0822/references/phix174_ill.ref.fa.gz'
    adapters_fasta      = 'adapters'   // BBDuk keyword for its bundled adapter set, or a fasta path
    bowtie2_index_dir   = null   // where host/PhiX indexes are stored and reused; null = ${outdir}/bowtie2_indexes

    // Read-level taxonomy: comma-separated list of kraken2, singlem, metaphlan.
    // kraken2 also runs Bracken on its report.
    read_taxonomy       = 'metaphlan'

    kraken2_db          = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/kraken2_pluspf'
    kraken2_confidence  = 0
    bracken_sif         = '/fs/ess/PAS0822/modules/singularity/bracken-3.1p1.sif'
    bracken_read_length = 150    // must match a database<N>mers.kmer_distrib file in kraken2_db
    bracken_level       = 'S'

    eggnog_db           = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/eggnog'
    eggnog_chunk_size   = 10000  // catalog genes per parallel eggNOG-mapper job

    singlem_metapackage = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/singlem/S3.1.0.metapackage_20221209.smpkg.zb'

    metaphlan_db        = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/mph4_2_db'
    metaphlan_index     = 'mpa_vJan25_CHOCOPhlAnSGB_202503'

    min_contig_size     = 1000

    max_memory          = '128.GB'
    max_cpus            = 16
    max_time            = '240.h'
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=PAS0822'
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
