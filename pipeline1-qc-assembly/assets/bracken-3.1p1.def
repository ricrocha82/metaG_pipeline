Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author Ricardo R. Pavan
    Software Bracken
    Version 3.1p1
    Source https://github.com/jenniferlu717/Bracken

%post
    set -e
    mamba create -y -n bracken_env -c conda-forge -c bioconda bracken=3.1p1
    mamba clean -a -y
    test -x /opt/conda/envs/bracken_env/bin/bracken

%environment
    export PATH="/opt/conda/envs/bracken_env/bin:${PATH}"
    export HOME=/tmp

%test
    bracken -h

