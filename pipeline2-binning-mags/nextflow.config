manifest {
    name        = 'pipeline2-binning-mags'
    description = 'Binning (MetaBAT2, SemiBin2, COMEBin), Binette refinement, dRep, CheckM2, GTDB-Tk, MAG abundance, DRAM'
    author      = 'ricrocha82'
}

params {
    input                       = null   // pipeline1's pipeline2_samplesheet.csv: sample,assembly,short_reads_1,short_reads_2
    outdir                      = './results'

    // References. Every default can be overridden on the command line.
    checkm2_db                  = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/CheckM2_database/uniref100.KO.1.dmnd'
    gtdbtk_db                   = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/GTDBTK_data/release226'
    comebin_simclr_patch        = '/fs/ess/community/CoMS_microbiome_tools/sif-apps_staging/comebin/patched_simclr.py'
    dram_db                     = '/fs/ess/community/CoMS_microbiome_tools/databases_staging/databases/DRAM_dbs/1.4.6'

    // Binning
    binning_seed                = 1
    min_contig_size             = 1500       // MetaBAT2 -m; 1500 is MetaBAT2's minimum
    semibin2_environment        = 'global'   // SemiBin2 pretrained model: global, human_oral, human_gut, ...
    // COMEBin's marker-gene seeding is unreliable below ~1024 contigs and
    // can return zero bins; smaller assemblies skip COMEBin and are refined
    // from MetaBAT2 + SemiBin2 only.
    comebin_min_contigs         = 1024

    // dRep. Defaults follow the CoMS workflow (70/10 quality filter, 98% ANI).
    drep_min_completeness       = 70
    drep_max_contamination      = 10
    drep_secondary_ani          = 0.98
    // dRep refuses genomeInfo when every contamination value is < 1 (it
    // assumes fractions). Only happens on tiny test runs; leave false.
    ignore_genome_quality       = false

    // CoverM MAG abundance matrix (CoMS: 0.70)
    coverm_min_covered_fraction = 0.70

    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=PAS0822'
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
