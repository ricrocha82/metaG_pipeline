process {
    errorStrategy = 'finish'
}

manifest {
    name        = 'pipeline2-binning-mags'
    description = 'Steps 10-14: binning (3 binners), METAWRAP refinement, CheckM2, GTDB-Tk, MAG abundance'
    author      = 'ricrocha82'
}

params {
    input                   = null   // samplesheet.csv: sample,assembly,short_reads_1,short_reads_2
    outdir                  = './results'
    binning_seed            = 1
    gtdbtk_db               = null
    checkm2_db              = null   // if null, auto-downloaded on first run (see CHECKM2_DOWNLOAD_DB)

    min_contig_size         = 1500

    ignore_genome_quality   = false

    // dRep quality thresholds -- made explicit rather than left as silent
    // tool defaults (dRep's actual defaults: 75/25). Adjust to match your
    // own stated methodology.
    drep_min_completeness   = 75
    drep_max_contamination  = 25

    max_memory              = '128.GB'
    max_cpus                = 16
    max_time                = '240.h'

    // COMEBins own release notes state datasets under ~1024 contigs are
    // unreliable for its marker-gene seeding step (used to auto-determine
    // cluster count for its Leiden clustering); below this, seeding can
    // find zero markers and produce zero bins regardless of batch-size
    // tuning. Samples below this threshold skip COMEBin entirely and are
    // refined from MetaBAT2 + SemiBin2 only -- see COUNT_CONTIGS branch
    // in main.nf.
    comebin_min_contigs     = 1024 
    ignore_genome_quality   = false
}

profiles {
    conda {
        conda.enabled       = true
        singularity.enabled = false
        apptainer.enabled   = false
    }

    singularity {
        // OSC Pitzer uses the `apptainer` binary. Nextflow treats
        // singularity and apptainer as interchangeable -- enabling either
        // scope works, but matching the actual installed binary name avoids
        // any version-detection ambiguity. Both scopes are set here so this
        // profile works regardless of which binary name Nextflow resolves.
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--cleanenv"

        // Left enabled so COMEBin/SemiBin2 -- which only declare a `conda`
        // directive, no `container` -- still resolve correctly under this
        // profile. Nextflow uses each process's `container` directive when
        // present, and falls back to conda for processes that declare only
        // a conda directive.
        conda.enabled          = true
    }

    apptainer{
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        apptainer.runOptions   = "--cleanenv"

        // Left enabled so COMEBin/SemiBin2 -- which only declare a `conda`
        // directive, no `container` -- still resolve correctly under this
        // profile. Nextflow uses each process's `container` directive when
        // present, and falls back to conda for processes that declare only
        // a conda directive.
        conda.enabled          = true
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=PAS1117'
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
